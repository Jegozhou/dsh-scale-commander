{
  "name": "@local/dsh-scale-commander",
  "version": "1.0.0",
  "private": true,
  "description": "Scale Commander — production Amazon PPC automation for DeepSeek Harness: rule engine, intelligent bidding, dayparting, negations, mass campaign builder, attribution analytics and audited rollback.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/host/*.js",
    "lib/host/schema.sql",
    "lib/shared/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}